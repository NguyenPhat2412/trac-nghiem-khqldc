# For an additional HTTPS reverse proxy only: copy to edge.conf and replace
# this documentation address with the exact, stable peer address nginx sees.
# Never trust all addresses or an entire shared/untrusted Docker network.
# The outer proxy MUST overwrite X-Forwarded-For with its verified client IP.
# Bind the gateway port so only that edge can reach it, then reload nginx.
set_real_ip_from 192.0.2.10;
real_ip_header X-Forwarded-For;
real_ip_recursive on;
